# =============================================================================
# YOLITIA Catalog — Git ignore
# =============================================================================

# Artefactos de catálogo (regenerables con scripts/build_catalog_v*.py)
#
# OJO: este repo es PUBLICO.
# Las fotos de ORIGEN vienen de MakerWorld con licencia "Standard Digital File
# License", que prohibe distribuir el trabajo del autor: NO se versionan.
# Las fotos UGC si, porque las generamos nosotros con la API de Alibaba.
output/
!output/
output/*
!output/ugc/

# Respaldos del catálogo (los genera scripts/respaldar.ps1).
# Son copias de lo que ya está versionado o de datos pesados: no van al repo.
respaldos/

# Fotos de ORIGEN sin procesar: vienen de MakerWorld con licencia que prohibe
# distribuirlas. Este repo es publico, asi que quedan fuera SIEMPRE.
assets/_incoming/
assets/images/productos_BACKUP/

# Respaldos de la base: se acumulan y no aportan al repo
data/*.bak-*
data/*BACKUP*

# Imágenes de productos descargadas.
# Se versionan SOLO las UGC (el producto puesto), que son nuestras.
assets/images/productos/
!assets/images/productos/
assets/images/productos/*
!assets/images/productos/*/
assets/images/productos/*/*
!assets/images/productos/*/*_ugc_*.jpg

# Catálogo PDF (se publica como GitHub Release, no en el repo)
dist/
public/catalogo-yolitia.pdf

# Base de datos y exports privados
data/yolitia.db
data/*.xlsx
data/*_import.*
data/yolitia_medusa_import.json
data/yolitia_prestashop_import.csv
data/yolitia_woocommerce_import.csv
data/yolitia_products_database.json
data/yolitia_products_database.xlsx
data/scraping_*.json
data/download_*.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
